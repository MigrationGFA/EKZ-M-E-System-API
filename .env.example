# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Postgres connection string (Neon in prod, local Postgres in dev)
DATABASE_URL=postgresql://USER@localhost:5432/ekz_me

# Generate with: openssl rand -base64 48
# Rotate per-environment; never share dev/prod secrets.
JWT_SECRET=replace-me-with-a-256-bit-random-value
JWT_EXPIRES_IN=8h

PORT=3000
CORS_ORIGINS=http://localhost:3001

# Initial password assigned to new users; they must change on first login.
# Use a strong value in production and rotate after seeding.
DEFAULT_USER_PASSWORD=replace-me

# Salt for SHA-256 hashing of beneficiary National Identification Numbers
# (ADR 0006). Generate with: openssl rand -base64 48
# WARNING: rotating this salt invalidates duplicate-detection on existing
# beneficiary records. Only rotate during a planned re-keying exercise.
BENEFICIARY_HASH_SALT=replace-me-with-a-256-bit-random-value

# SMTP (transactional mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Azure Blob Storage (submission photos/videos).
# If unset, app falls back to ./uploads — do NOT do this in production
# (see AUDIT_FINDINGS §1.4).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_IMAGES=
AZURE_CONTAINER_VIDEOS=
# Evidence-document blobs (ADR 0005) AND supervision report PDFs (Phase 9
# — keyed under `reports/`). Lowercase, no hyphens per Azure container
# naming rules. The container is created on first upload if the connection
# string permits; otherwise provision it manually.
AZURE_CONTAINER_DOCUMENTS=wiftdocuments
